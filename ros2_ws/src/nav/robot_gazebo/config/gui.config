<?xml version="1.0"?>
<window>
  <width>1440</width><height>1000</height>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="DASE7503 Gazebo">
  <gz-gui><title>DASE7503 - Gazebo Harmonic</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.65 0.65 0.65</ambient_light>
  <background_color>0.2 0.24 0.3</background_color>
  <camera_pose>4.1 -2.3 3.8 0 0.73 2.24</camera_pose>
  <horizontal_fov>48</horizontal_fov>
</plugin>
<plugin filename="GzSceneManager" name="Scene manager">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="View control">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="EntityContextMenuPlugin" name="Entity context menu">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">220</property><property key="height" type="double">72</property>
    <property key="showTitleBar" type="bool">false</property>
    <anchors target="DASE7503 - Gazebo Harmonic"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <play_pause>true</play_pause><start_paused>false</start_paused>
  <service>/world/course/control</service>
  <stats_topic>/world/course/stats</stats_topic>
</plugin>
<plugin filename="WorldStats" name="World statistics">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">290</property><property key="height" type="double">110</property>
    <property key="showTitleBar" type="bool">false</property>
    <anchors target="DASE7503 - Gazebo Harmonic"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
</plugin>
