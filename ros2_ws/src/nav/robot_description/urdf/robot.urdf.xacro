<?xml version="1.0"?>
<!--
  DASE7503 mecanum logistics robot.

  base_link: ground projection of the chassis centre, x forward, y left, z up.
  All lengths in m, angles in rad.
-->
<robot name="dase7503_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="geometry_file" default="$(find robot_description)/config/mechanical.yaml"/>
  <xacro:property name="g" value="${xacro.load_yaml('$(arg geometry_file)')}"/>
  <xacro:property name="body_length" value="${g['body_length_mm'] / 1000}"/>
  <xacro:property name="body_width" value="${g['body_width_mm'] / 1000}"/>
  <xacro:property name="body_height" value="${g['body_height_mm'] / 1000}"/>
  <xacro:property name="body_clearance" value="${g['body_clearance_mm'] / 1000}"/>
  <xacro:property name="wheel_radius" value="${g['wheel_radius_mm'] / 1000}"/>
  <xacro:property name="wheel_width" value="${g['wheel_width_mm'] / 1000}"/>
  <xacro:property name="wheel_base" value="${g['wheel_base_mm'] / 1000}"/>
  <xacro:property name="wheel_track" value="${g['wheel_track_mm'] / 1000}"/>
  <xacro:property name="laser_xyz" value="${g['laser_xyz_mm']}"/>
  <xacro:property name="laser_rpy" value="${g['laser_rpy_rad']}"/>
  <xacro:property name="camera_xyz" value="${g['camera_xyz_mm']}"/>
  <xacro:property name="camera_rpy" value="${g['camera_rpy_rad']}"/>
  <xacro:property name="imu_xyz" value="${g['imu_xyz_mm']}"/>
  <xacro:property name="imu_rpy" value="${g['imu_rpy_rad']}"/>

  <!-- ===== Materials ===== -->
  <material name="body_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <!-- ===== Chassis ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_clearance + body_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_clearance + body_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ===== Wheels =====
       Fixed joints: the wheels are only drawn, so no joint_states are needed. -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
    </link>
    <joint name="${name}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left" x="${wheel_base / 2}" y="${wheel_track / 2}"/>
  <xacro:wheel name="front_right" x="${wheel_base / 2}" y="${-wheel_track / 2}"/>
  <xacro:wheel name="rear_left" x="${-wheel_base / 2}" y="${wheel_track / 2}"/>
  <xacro:wheel name="rear_right" x="${-wheel_base / 2}" y="${-wheel_track / 2}"/>

  <!-- ===== Sensors ===== -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_xyz[0]/1000} ${laser_xyz[1]/1000} ${laser_xyz[2]/1000}" rpy="${laser_rpy[0]} ${laser_rpy[1]} ${laser_rpy[2]}"/>
  </joint>

  <!-- camera_link follows the ROS body convention (x forward). -->
  <link name="camera_link">
    <visual>
      <origin xyz="-0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.06 0.03"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz[0]/1000} ${camera_xyz[1]/1000} ${camera_xyz[2]/1000}" rpy="${camera_rpy[0]} ${camera_rpy[1]} ${camera_rpy[2]}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz[0]/1000} ${imu_xyz[1]/1000} ${imu_xyz[2]/1000}" rpy="${imu_rpy[0]} ${imu_rpy[1]} ${imu_rpy[2]}"/>
  </joint>

  <!-- Planar simulation is provided by robot_simulation. -->

  <!-- REP-103 optical axes: x right, y down, z forward. The camera's physical
       translation and pitch above still need to be measured from the CAD. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>
